diff --git a/src/Gml.Launcher/Core/Services/BackendSelectionService.cs b/src/Gml.Launcher/Core/Services/BackendSelectionService.cs
new file mode 100644
index 0000000..15cbe1f
--- /dev/null
+++ b/src/Gml.Launcher/Core/Services/BackendSelectionService.cs
@@ -0,0 +1,77 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Text.Json;
+using Gml.Launcher.Assets;
+
+namespace Gml.Launcher.Core.Services;
+
+public sealed record BackendEndpoint(string Id, string Name, string Url);
+
+/// <summary>Persists the selected backend independently of the active GmlClientManager.
+/// A restart is required because GmlClientManager creates its HTTP and SignalR clients in its constructor.
+/// </summary>
+public static class BackendSelectionService
+{
+    public static IReadOnlyList<BackendEndpoint> Endpoints { get; } = new[]
+    {
+        new BackendEndpoint("RU1", "RU1", "https://gmlfr.vestalis.xyz/"),
+        new BackendEndpoint("RU2", "RU2", "https://gmlfrr.vestalis.xyz/"),
+        new BackendEndpoint("PO", "PO", "https://201-58-180-2.sslip.io/"),
+        new BackendEndpoint("MSK1", "MSK1", "https://msk1.gmlfr.vestalis.xyz/")
+    };
+
+    private static string ConfigPath
+    {
+        get
+        {
+            var root = OperatingSystem.IsWindows()
+                ? Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData)
+                : Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
+
+            return Path.Combine(root, ResourceKeysDictionary.FolderName, "backend-selection.json");
+        }
+    }
+
+    public static BackendEndpoint GetSelected()
+    {
+        try
+        {
+            if (File.Exists(ConfigPath))
+            {
+                var config = JsonSerializer.Deserialize<SelectionConfig>(File.ReadAllText(ConfigPath));
+                var selected = Endpoints.FirstOrDefault(x =>
+                    string.Equals(x.Id, config?.BackendId, StringComparison.OrdinalIgnoreCase));
+
+                if (selected is not null)
+                    return selected;
+            }
+        }
+        catch (IOException) { }
+        catch (UnauthorizedAccessException) { }
+        catch (JsonException) { }
+
+        return Endpoints[0];
+    }
+
+    public static void Save(BackendEndpoint endpoint)
+    {
+        ArgumentNullException.ThrowIfNull(endpoint);
+
+        // Only known endpoints are accepted; don't persist arbitrary URLs.
+        var knownEndpoint = Endpoints.FirstOrDefault(x =>
+            string.Equals(x.Id, endpoint.Id, StringComparison.OrdinalIgnoreCase));
+
+        if (knownEndpoint is null)
+            throw new ArgumentException("Unknown backend selection.", nameof(endpoint));
+
+        var directory = Path.GetDirectoryName(ConfigPath)
+            ?? throw new InvalidOperationException("Cannot determine backend config directory.");
+
+        Directory.CreateDirectory(directory);
+        File.WriteAllText(ConfigPath, JsonSerializer.Serialize(new SelectionConfig(knownEndpoint.Id)));
+    }
+
+    private sealed record SelectionConfig(string BackendId);
+}
