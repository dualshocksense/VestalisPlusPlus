<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Gml.Launcher.Views.Components"
             xmlns:lang="clr-namespace:Gml.Launcher.Assets.Resources"
             xmlns:vm="clr-namespace:Gml.Launcher.ViewModels.Pages"
             xmlns:converters="clr-namespace:Gml.Launcher.Core.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="600"
             x:DataType="vm:SettingsPageViewModel"
             x:Class="Gml.Launcher.Views.Pages.SettingsPageView">
    <Grid>
        <!-- Background -->
        <components:BackgroundComponent Grid.Column="0" />
        <Border Padding="20">
            <Grid ColumnDefinitions="350, 30, .6*, 30 0.2*" RowDefinitions="Auto, 30, *">

                <!-- Navigation -->
                <Grid Grid.ColumnSpan="3" Grid.Row="0">
                    <components:GmlButton Classes="TextIcon Additional"
                                          Padding="15, 0, 20 ,0"
                                          IconPath="/Assets/Images/back.svg"
                                          IconSize="22"
                                          Text="{x:Static lang:Resources.Back}"
                                          Command="{Binding GoBackCommand}" />
                </Grid>

                <!-- RAM and JVM arguments -->
                <ScrollViewer Grid.Row="2"
                              Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="20">
                        <components:StackFrameBorder Spacing="10"
                                                      VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0, 0, 0, 10"
                                        Spacing="10">
                                <Svg Path="/Assets/Images/ram.svg"
                                     Width="28"
                                     Height="28" />
                                <TextBlock Text="{x:Static lang:Resources.SettingsRamTitle}"
                                           Classes="HeadlineText"
                                           Margin="0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Static lang:Resources.SettingsRamDescription}"
                                       TextWrapping="Wrap"
                                       Margin="38, 0, 0, 0"
                                       LineHeight="25"
                                       Classes="FormText" />

                            <Border Classes="Separator" Margin="0, 10" />

                            <TextBlock Text="{x:Static lang:Resources.JvmXmsTitle}"
                                       Classes="FormText"
                                       FontSize="15" />
                            <TextBlock Text="{x:Static lang:Resources.JvmXmsDescription}"
                                       Classes="FormText"
                                       TextWrapping="Wrap" />
                            <Slider Minimum="{Binding MinJvmRamValue}"
                                    Maximum="{Binding XmxRamValue}"
                                    Value="{Binding XmsRamValue, Mode=TwoWay}"
                                    TickFrequency="{Binding RamTickValue}"
                                    IsSnapToTickEnabled="True"
                                    Classes="FormSlider" />
                            <TextBlock Text="{Binding XmsRamValueView}"
                                       Classes="FormText"
                                       FontSize="16"
                                       Foreground="{DynamicResource HeadlineColor}"
                                       HorizontalAlignment="Right" />

                            <Border Classes="Separator" Margin="0, 5" />

                            <TextBlock Text="{x:Static lang:Resources.JvmXmxTitle}"
                                       Classes="FormText"
                                       FontSize="15" />
                            <TextBlock Text="{x:Static lang:Resources.JvmXmxDescription}"
                                       Classes="FormText"
                                       TextWrapping="Wrap" />
                            <Slider Minimum="{Binding MinXmxRamValue}"
                                    Maximum="{Binding MaxJvmRamValue}"
                                    Value="{Binding XmxRamValue, Mode=TwoWay}"
                                    TickFrequency="{Binding RamTickValue}"
                                    IsSnapToTickEnabled="True"
                                    Classes="FormSlider" />
                            <TextBlock Text="{Binding XmxRamValueView}"
                                       Classes="FormText"
                                       FontSize="16"
                                       Foreground="{DynamicResource HeadlineColor}"
                                       HorizontalAlignment="Right" />
                        </components:StackFrameBorder>

                        <!-- Additional JVM arguments -->
                        <components:StackFrameBorder Spacing="10" VerticalAlignment="Top">
                            <TextBlock Text="{x:Static lang:Resources.JvmArgsTitle}"
                                       Classes="HeadlineText"
                                       TextWrapping="Wrap" />
                            <Border Classes="Separator" Margin="0, 5" />
                            <TextBlock Text="{x:Static lang:Resources.JvmArgsDescription}"
                                       Classes="FormText"
                                       TextWrapping="Wrap" />
                            <TextBox Classes="FormBox"
                                     Text="{Binding CustomJvmArguments, Mode=TwoWay}"
                                     Watermark="{x:Static lang:Resources.JvmArgsPlaceholder}" />
                        </components:StackFrameBorder>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2"
                            Grid.Column="2"
                            Spacing="20">

                    <!-- Game Window Size -->
                    <components:StackFrameBorder
                        Spacing="10"
                        VerticalAlignment="Top">

                        <StackPanel Orientation="Horizontal"
                                    Margin="0, 0, 0, 10"
                                    Spacing="10">
                            <Svg Path="/Assets/Images/window.svg"
                                 Width="28"
                                 Height="28" />
                            <TextBlock Text="{x:Static lang:Resources.WindowSize}"
                                       Margin="0"
                                       Classes="HeadlineText" />
                        </StackPanel>

                        <Border Classes="Separator" Margin="0, 10" />

                        <CheckBox Content="{x:Static lang:Resources.FullScreen}"
                                  Classes="FormCheckBox"
                                  IsChecked="{Binding FullScreen}" />

                        <Border Classes="Separator" Margin="0, 10"
                                IsVisible="{Binding FullScreen, Converter={converters:BoolReverseConverter}}" />

                        <Grid ColumnDefinitions="*, 10, Auto, 10, *"
                              Margin="0, 10, 0, 0"
                              IsVisible="{Binding FullScreen, Converter={converters:BoolReverseConverter}}">
                            <TextBox Grid.Column="0"
                                     Classes="FormBox"
                                     Text="{Binding WindowWidth}"
                                     TextChanged="OnTextInput" />
                            <TextBlock Text="x"
                                       Classes="FormText"
                                       VerticalAlignment="Center"
                                       Grid.Column="2" />
                            <TextBox Grid.Column="4"
                                     TextChanged="OnTextInput"
                                     Text="{Binding WindowHeight}"
                                     Classes="FormBox" />
                        </Grid>


                    </components:StackFrameBorder>

                    <!-- Installation directory -->
                    <components:StackFrameBorder
                        Spacing="10"
                        VerticalAlignment="Top">

                        <StackPanel Orientation="Horizontal"
                                    Margin="0, 0, 0, 10"
                                    Spacing="10">
                            <Svg Path="/Assets/Images/folder.svg"
                                 Width="28"
                                 Height="28" />
                            <TextBlock Text="{x:Static lang:Resources.InstallationDirectory}"
                                       Margin="0"
                                       Classes="HeadlineText" />
                        </StackPanel>

                        <Border Classes="Separator" Margin="0, 10" />

                        <Grid Margin="0, 10, 0, 0"
                              ColumnDefinitions="*, 15, Auto">
                            <TextBox Grid.Column="0"
                                     Classes="FormBox"
                                     Text="{Binding InstallationFolder}" />

                            <StackPanel Grid.Column="2" Spacing="10" Orientation="Horizontal">
                                <components:GmlButton Classes="Icon Additional"
                                                      IconPath="/Assets/Images/folder.svg"
                                                      IconSize="22"
                                                      HorizontalAlignment="Right"
                                                      CornerRadius="10"
                                                      Click="OpenLocation"
                                                      Text="{x:Static lang:Resources.Edit}" />
                                <components:GmlButton Classes="Icon Additional"
                                                      IconPath="/Assets/Images/edit.svg"
                                                      IconSize="22"
                                                      HorizontalAlignment="Right"
                                                      CornerRadius="10"
                                                      Click="OpenFileDialog"
                                                      Text="{x:Static lang:Resources.Edit}" />
                            </StackPanel>

                        </Grid>

                    </components:StackFrameBorder>

                </StackPanel>

                <!-- Language -->
                <ComboBox Grid.Column="4"
                          Grid.Row="2"
                          Classes="ComboBoxStyle"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Right"
                          ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Svg Path="{Binding IconPath}"
                                     Width="18"/>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>


            </Grid>
        </Border>
    </Grid>
</UserControl>
